{
  "name": "app-trail",
  "version": "1.0.0",
  "private": true,
  "description": "Single-page job application tracker. The app itself has no dependencies and no build step - these are test-only devDependencies.",
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/demo.js",
    "demo:fellowship": "node scripts/demo.js fellowship",
    "demo:homestar": "node scripts/demo.js homestar",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "jsdom": "^25.0.1",
    "memfs": "^4.80.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "24.x"
  },
  "license": "MIT"
}
